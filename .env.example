# HelpDesk Lite Environment Variables Example
# Duplicate this file to .env or .env.local and adjust configuration values.

# Runtime Environment
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk_lite?schema=public"

# Authentication & Security
JWT_SECRET="helpdesk-lite-jwt-secret-key-at-least-32-characters-long"
JWT_EXPIRES_IN="1d"
COOKIE_SECRET="helpdesk-lite-cookie-secret-key-for-session-signing"
SESSION_SECRET="helpdesk-lite-session-secret-key-for-audit-and-sessions"
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15

# URLs & CORS
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Mailer Configuration
# Supported transports: 'console' (for local dev/testing), 'smtp' (for production)
MAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@helpdesk-lite.local"
