{
  "name": "helpdesk-lite-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "db:init": "node scripts/db.js init",
    "db:start": "node scripts/db.js start",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:push": "npm run prisma:push --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:shared": "npm run build --workspace=shared",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "test": "npm run test --workspace=shared && npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:e2e": "npm run test:e2e --workspace=backend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.2.5"
  }
}
